# Moonwalk — environment variables
#
#   cp backend/.env.example backend/.env
#
# Loaded automatically by the backend (local_server.py, cloud_server.py,
# hub/__main__.py, agent/core_v2.py, providers/router.py).
# Only GEMINI_API_KEY is required; everything else has a working default.
# Never commit the real backend/.env — it is covered by .gitignore.


# ─────────────────────────────────────────────────────────────
#  Required
# ─────────────────────────────────────────────────────────────

# Google Gemini API key — the agent brain. https://aistudio.google.com
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────
#  Recommended
# ─────────────────────────────────────────────────────────────

# Wake word detection ("Hey Moonwalk"). https://console.picovoice.ai (free tier).
# Without it the wake word is disabled — use the Ctrl+Shift+Space hotkey instead.
# The desktop app ships a bundled key, so this is only needed for a bare backend.
PICOVOICE_ACCESS_KEY=


# ─────────────────────────────────────────────────────────────
#  Model overrides
# ─────────────────────────────────────────────────────────────

# Defaults live in backend/providers/models.py — the single source of truth.
# These variables override them; an empty value is ignored (the default wins).
#
# GEMINI_ROUTING_MODEL=gemini-3.5-flash       # Tier 0 — classifies FAST vs POWERFUL
# GEMINI_FAST_MODEL=gemini-3.5-flash          # Tier 1 — simple single-step tasks
# GEMINI_POWERFUL_MODEL=gemini-3.5-flash      # Tier 2 — complex multi-step reasoning
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash      # Emergency fallback on POWERFUL failure
#
# Aliases: the public ids above are served by a dated family member, and the
# quota is billed to THAT model. Requesting gemini-3.5-flash is billed to
# gemini-3.6-flash, so an API error can name a model you never configured.
# This is normal — the startup log prints the resolved name on the first call.
#
# Free tier: 20 generate-content requests per day, PER PROJECT PER MODEL.
# Creating a new API key inside the same Google AI Studio project does NOT
# reset it. To keep working after exhausting one model, point a tier at a
# different family (each has its own daily bucket), e.g.:
#   GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# MOONWALK_EMBEDDING_MODEL=text-embedding-004                  # RAG embeddings
# MOONWALK_AGENT_VERSION=v2                                    # Agent implementation: v1 | v2

# Optional: route fresh requests through the LangGraph workflow
# (understand → plan → validate → execute → evaluate → respond).
# Default OFF — the original agent path runs. See docs/LANGGRAPH.md.
# MOONWALK_USE_LANGGRAPH=1


# ─────────────────────────────────────────────────────────────
#  Speech-to-text
# ─────────────────────────────────────────────────────────────

# MOONWALK_STT_PROVIDER=google          # google | gnani | sarvam
# MOONWALK_STT_FALLBACK=google          # provider used when the primary fails ("" to disable)
# MOONWALK_STT_LANGUAGE=en-US           # en-IN also handles Hindi-English mixed speech on Gnani
# MOONWALK_STT_TIMEOUT=20               # seconds

# Gnani (Vachana STT / Timbre TTS) — https://gnani.ai
# GNANI_API_KEY=
# GNANI_STT_FORMAT=transcribe
# GNANI_STT_BIAS_WORDS=                 # comma-separated hint words
# GNANI_STT_BIAS_SCORE=1.0

# Sarvam (Saaras STT / Bulbul TTS) — https://sarvam.ai
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe


# ─────────────────────────────────────────────────────────────
#  Text-to-speech
# ─────────────────────────────────────────────────────────────

# MOONWALK_TTS_PROVIDER=google          # google | gnani | sarvam
# MOONWALK_TTS_FALLBACK=google          # set to anything else to disable the Google fallback
# MOONWALK_TTS_VOICE=en-US-Neural2-J    # Google Cloud TTS voice
# MOONWALK_TTS_LANGUAGE=en-US
# MOONWALK_TTS_SPEED=1.05               # 1.0 = normal
# MOONWALK_TTS_TIMEOUT=30               # seconds

# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_TTS_VOICE=Poorvi
# GNANI_TTS_LANGUAGE=hi-en
# GNANI_TTS_SPEED=1.0
# GNANI_TTS_SAMPLE_RATE=48000

# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_LANGUAGE=hi-IN
# SARVAM_TTS_PACE=

# Google Cloud credentials for Google STT/TTS (path to a service account JSON)
# GOOGLE_APPLICATION_CREDENTIALS=


# ─────────────────────────────────────────────────────────────
#  Phone voice agents (Bolna)
# ─────────────────────────────────────────────────────────────

# BOLNA_API_KEY=
# BOLNA_AGENT_ID=
# BOLNA_API_BASE=https://api.bolna.ai
# BOLNA_ALLOWED_PREFIXES=               # comma-separated dial prefixes, e.g. +91,+1


# ─────────────────────────────────────────────────────────────
#  Ports & local endpoints
# ─────────────────────────────────────────────────────────────

# MOONWALK_BACKEND_HOST=127.0.0.1
# MOONWALK_BACKEND_PORT=8000                        # main Python WebSocket server
# MOONWALK_BACKEND_WS_URL=ws://127.0.0.1:8000/ws    # used by the Electron main process
# MOONWALK_BROWSER_BRIDGE_HOST=127.0.0.1
# MOONWALK_BROWSER_BRIDGE_PORT=8765                 # Chrome extension bridge
# MOONWALK_BROWSER_BRIDGE_TOKEN=                    # shared secret for the extension handshake
# MOONWALK_HUB_PORT=8787                            # hub server
# MOONWALK_HUB_URL=ws://127.0.0.1:8787/helper       # hub URL the Windows helper connects to
# MOONWALK_HELPER_TOKEN=                            # auth token for the Windows helper
# MOONWALK_WEB_DIR=                                 # override the static web_app directory
# MOONWALK_USER_DIR=                                # override the config dir (%APPDATA%\Moonwalk)
# LIQUID_HOTKEY=CommandOrControl+Shift+Space,Alt+Space


# ─────────────────────────────────────────────────────────────
#  Cloud mode (Cloud Run brain + local client)
# ─────────────────────────────────────────────────────────────

# MOONWALK_CLOUD_URL=ws://localhost:8080    # cloud brain WebSocket; enables mac_client.py
# MOONWALK_CLOUD_TOKEN=                     # must match AUTH_SHARED_SECRET on the server
# MOONWALK_GOOGLE_CLIENT_ID=                # Google Sign-In client ID(s), comma-separated
# MOONWALK_USER_ID=default
# MOONWALK_AGENT_IDLE_TIMEOUT=3600          # seconds before an idle cloud agent is dropped
# HOST=0.0.0.0                              # cloud_server bind host
# PORT=8080                                 # cloud_server bind port

# Cloud memory storage
# GCP_PROJECT=
# MOONWALK_GCS_BUCKET=                      # defaults to <GCP_PROJECT>-moonwalk-memory
