# ClarityOS — environment variables
#
#   cp backend/.env.example backend/.env
#
# Never commit the real backend/.env — .gitignore already covers it.
#
# Only the settings people actually change are listed here. Everything else
# has a working default in code; see backend/hub/config.py and
# backend/providers/models.py if you need to go deeper.


# ═════════════════════════════════════════════════════════════
#  API KEYS — the only part most people need to fill in
# ═════════════════════════════════════════════════════════════
#
#   KEY                             NEEDED FOR                      WHERE
#   GEMINI_API_KEY        REQUIRED  the agent brain                 aistudio.google.com
#   GNANI_API_KEY         optional  Gnani STT + TTS (Indic voices)  gnani.ai
#   SARVAM_API_KEY        optional  Sarvam STT + TTS (Indic)        sarvam.ai
#   PICOVOICE_ACCESS_KEY  optional  "Hey ClarityOS" wake word       console.picovoice.ai
#   BOLNA_API_KEY         optional  outbound phone voice agents     bolna.ai
#   GOOGLE_APPLICATION_CREDENTIALS  Google Cloud STT/TTS            path to a service-account JSON
#   EVON_API_KEY          optional  only if YOUR Evon server wants one
#
# Everything works with just GEMINI_API_KEY. The rest switch on extra engines;
# without them those engines are simply unavailable.
#
# Gemini / Gnani / Sarvam / Bolna can also be set in the app
# (Settings → API keys), where they are stored encrypted — and a key saved
# there WINS over the one here. If a key in this file seems to be ignored,
# that is why: clear it from Settings first.

GEMINI_API_KEY=

# GNANI_API_KEY=
# SARVAM_API_KEY=
# BOLNA_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# The desktop app ships a bundled Picovoice key, so this is only needed when
# running a bare backend. Without it the wake word is off — use Ctrl+Shift+Space.
# PICOVOICE_ACCESS_KEY=


# ═════════════════════════════════════════════════════════════
#  Speech-to-text
# ═════════════════════════════════════════════════════════════

# Gnani Prisma v2.5 over the realtime socket: audio is sent while you are
# still speaking, so the transcript is ready almost as soon as you stop. Falls
# back to gnani (REST), then to the engine in CLARITYOS_STT_FALLBACK.
CLARITYOS_STT_PROVIDER=gnani-stream   # google | gnani | gnani-stream | sarvam
CLARITYOS_STT_LANGUAGE=en-IN          # handles Hindi-English mixed speech, answers in Latin
# CLARITYOS_STT_FALLBACK=google       # used if Gnani is unreachable ("" to disable)

# Gnani — clips are capped at 30s, the documented maximum for this endpoint.
# GNANI_STT_MODEL=prisma-v2.5      # pinned; the server-side default can move
# GNANI_STT_FORMAT=transcribe      # transcribe = "5,000"; verbatim = "five thousand"
# GNANI_STT_BIAS_WORDS=            # comma-separated hint words
# GNANI_STT_BIAS_SCORE=1.0         # only 0.0 / 0.5 / 1.0 / 1.5 / 2.0 are accepted

# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe


# ═════════════════════════════════════════════════════════════
#  Text-to-speech
# ═════════════════════════════════════════════════════════════

# Gnani Timbre v2.5, streamed over SSE so speech starts before the whole
# sentence has been synthesized.
CLARITYOS_TTS_PROVIDER=gnani          # google | gnani | sarvam
# CLARITYOS_TTS_FALLBACK=google       # anything else disables the Google fallback
# CLARITYOS_TTS_STREAM=1              # 0 turns off progressive (SSE) synthesis
# CLARITYOS_TTS_VOICE=en-US-Neural2-J # Google voice; ignored while Gnani is active
# CLARITYOS_TTS_SPEED=1.05

# Gnani allows one synthesis request at a time, so ClarityOS serialises them
# rather than collecting 429s.
# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_TTS_VOICE=Poorvi           # voices are tied to a model; these are v2.5 voices
# GNANI_TTS_LANGUAGE=hi-en
# GNANI_TTS_SPEED=1.0              # Timbre accepts 0.85–1.15; outside that it is clamped
# GNANI_TTS_SAMPLE_RATE=48000

# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_LANGUAGE=hi-IN


# ═════════════════════════════════════════════════════════════
#  Models & reasoning
# ═════════════════════════════════════════════════════════════

# Free tier is 20 requests/day PER PROJECT PER MODEL — a new key in the same
# Google AI Studio project does not reset it. Point a tier at a different
# family to keep working, e.g. GEMINI_FAST_MODEL=gemini-3.1-flash-lite.
# GEMINI_ROUTING_MODEL=gemini-3.5-flash    # Tier 0 — classifies FAST vs POWERFUL
# GEMINI_FAST_MODEL=gemini-3.5-flash       # Tier 1 — simple single-step tasks
# GEMINI_POWERFUL_MODEL=gemini-3.5-flash   # Tier 2 — complex multi-step reasoning
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash   # used when POWERFUL fails

# CLARITYOS_USE_LANGGRAPH=1        # route through the LangGraph workflow (docs/LANGGRAPH.md)

# Gnani Evon v3.3 is open-weight and has no published hosted endpoint. Point
# this at a deployment YOU run (vLLM, SGLang, …) serving the OpenAI-compatible
# chat-completions API. Used only when the URL is set AND the server answers;
# otherwise ClarityOS logs why and stays on Gemini.
# CLARITYOS_LLM_PROVIDER=gemini    # gemini | evon
# EVON_BASE_URL=http://localhost:8000/v1
# EVON_MODEL=gnani-evon-v3.3       # whatever name your server serves
# EVON_API_KEY=                    # sent as "Authorization: Bearer …" when set


# ═════════════════════════════════════════════════════════════
#  Phone voice agents (Bolna)
# ═════════════════════════════════════════════════════════════

# BOLNA_AGENT_ID=
# BOLNA_ALLOWED_PREFIXES=          # comma-separated dial prefixes, e.g. +91,+1


# ═════════════════════════════════════════════════════════════
#  Ports — only if something else already owns one
# ═════════════════════════════════════════════════════════════

# CLARITYOS_BACKEND_PORT=8000        # Python WebSocket server
# CLARITYOS_BROWSER_BRIDGE_PORT=8765 # Chrome extension bridge
# CLARITYOS_HUB_PORT=8787            # hub dashboard + API
# LIQUID_HOTKEY=CommandOrControl+Shift+Space,Alt+Space
